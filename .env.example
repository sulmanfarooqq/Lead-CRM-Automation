# Copy to .env and fill in. Never commit .env.
APP_NAME=Techtox Lead Response Agent
ENVIRONMENT=development          # set to "production" on a real deployment (enforces strong secrets)
LOG_LEVEL=INFO

# --- Authentication -----------------------------------------------------------------------
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=                  # sent by the form bridge in the X-Webhook-Secret header (or "secret" in the body)
API_KEY=                         # required in the X-API-Key header for every /api/* endpoint

# --- Storage and locale -------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/leads.db
DEFAULT_COUNTRY_CODE=+92
TIMEZONE=Asia/Karachi
MAX_REQUEST_BYTES=65536

# --- monday.com (optional; leave MONDAY_API_TOKEN empty to run without a CRM) ---------------
MONDAY_API_TOKEN=
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_API_VERSION=              # empty = monday's current default API version
MONDAY_ACCOUNT_URL=              # https://your-account.monday.com  (used for links in emails/tasks)
MONDAY_BOARD_ID=
MONDAY_GROUP_ID=topics
MONDAY_EMAIL_COLUMN_ID=
MONDAY_PHONE_COLUMN_ID=
MONDAY_PROPERTY_TYPE_COLUMN_ID=
MONDAY_BUDGET_COLUMN_ID=         # a Numbers column
MONDAY_LOCATION_COLUMN_ID=
MONDAY_TIMELINE_COLUMN_ID=
MONDAY_MESSAGE_COLUMN_ID=        # a Long text column
MONDAY_STAGE_COLUMN_ID=          # a Status column
MONDAY_PRIORITY_COLUMN_ID=       # a Status column
MONDAY_FOLLOWUP_COLUMN_ID=       # a Date column
MONDAY_OWNER_COLUMN_ID=          # optional People column; also set monday_user_id per rep in config/routing_rules.json
# Optional separate "Follow-up Tasks" board
MONDAY_TASK_BOARD_ID=
MONDAY_TASK_GROUP_ID=topics
MONDAY_TASK_DUE_COLUMN_ID=       # a Date column
MONDAY_TASK_NOTES_COLUMN_ID=     # a Text column

# --- Email (SMTP) and Slack (both optional, internal team only) ----------------------------
SMTP_HOST=
SMTP_PORT=587                    # 587 = STARTTLS, 465 = implicit SSL
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SALES_REP_EMAIL=                 # used when a rep in routing_rules.json has no real address
ADMIN_EMAIL=                     # receives rejected-lead and failure alerts
SLACK_WEBHOOK_URL=
